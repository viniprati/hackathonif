# A conexão também pode vir de MONGO_URI no arquivo .ENV da raiz.
# MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER/?retryWrites=true&w=majority
MONGO_DB_NAME=nativa
# Segredo do servidor para assinar JWT; nunca embutir no Flutter.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
# Conta única local de demonstração. Configure a senha apenas no arquivo .env.
MVP_CPF=12345678900
MVP_PASSWORD=SUBSTITUA_LOCALMENTE
HOST=127.0.0.1
PORT=3000
# Origens exatas separadas por vírgula. Vazio não habilita acesso CORS.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Opcional: JSON da conta de serviço Firebase Admin, somente no servidor.
# Sem esta variável, a central de avisos funciona, mas push fica indisponível.
FIREBASE_SERVICE_ACCOUNT_JSON=
